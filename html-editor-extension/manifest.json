{
  "manifest_version": 3,
  "name": "AI HTML 汇报修改台",
  "short_name": "汇报修改台",
  "version": "1.0.0",
  "description": "AI 生成 HTML 汇报的最后一公里。点一下把当前网页载入修改台：改文字、换图、调排版，导出干净的 HTML。",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "用 HTML 画板编辑当前页面",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-editor": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "用 HTML 画板编辑当前页面"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["editor/editor.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
